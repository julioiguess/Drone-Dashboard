<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DashboardController"
            prefWidth="1500"
            prefHeight="950"
            stylesheets="@dashboard.css"
            styleClass="dashboard"
            style="-fx-background-color: #101820;">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER"
              prefHeight="65"
              styleClass="header">

            <Label text="Farm Drone Management System"
                   styleClass="header-title"/>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    prefWidth="280"
                    style="-fx-background: #17232e; -fx-background-color: #17232e;">

            <VBox spacing="0"
                  styleClass="sidebar">

                <VBox spacing="12"
                      styleClass="sidebar-section">

                    <Label text="DASHBOARD"
                           styleClass="sidebar-title"/>

                    <Separator/>

                    <Button text="▸ Overview"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showOverview"/>

                    <Button text="Farm Map"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showFarmMap"/>

                    <Button text="Soil Moisture"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showSoilMoisture"/>

                    <Button text="Crop Growth"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showCropGrowth"/>

                    <Button text="Harvest"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showHarvest"/>

                    <Button text="Equipment"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showEquipment"/>

                    <Button text="Drone Missions"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showMissions"/>

                    <Button text="Drones"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showDrones"/>

                    <Button text="Alerts"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showAlerts"/>
                </VBox>

                <VBox spacing="12"
                      styleClass="sidebar-section">

                    <Label text="ACTIONS"
                           styleClass="section-heading"/>

                    <Separator/>

                    <Button text="Search Livestock"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showLivestock"/>

                    <Button text="▸ Water — Zone 1"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showIrrigation"/>

                    <Button text="▸ Water — Zone 2"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showIrrigation"/>

                    <Button text="▸ Field — Zone 1"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showFields"/>

                    <Button text="▸ Field — Zone 2"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showFields"/>

                    <Separator/>

                    <Button text="Reload Saved Data"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#reloadData"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </left>

    <!-- MAIN CONTENT: ONLY THIS AREA CHANGES DURING NAVIGATION -->
    <center>
        <BorderPane fx:id="contentPane"
                    styleClass="main-content"
                    style="-fx-background-color: #aab4bd;">

            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
        </BorderPane>
    </center>

    <!-- RIGHT SIDEBAR: ALWAYS VISIBLE -->
    <right>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    prefWidth="280"
                    style="-fx-background: #17232e; -fx-background-color: #17232e;">

            <VBox spacing="0"
                  styleClass="right-sidebar">

                <!-- RECENT ALERTS -->
                <VBox spacing="12"
                      styleClass="info-panel">

                    <Label text="RECENT ALERTS"
                           styleClass="alerts-heading"/>

                    <Separator/>

                    <VBox fx:id="recentAlertsBox"
                          spacing="12"/>

                    <Button text="View All Alerts"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showAlerts"/>
                </VBox>

                <!-- TODAY'S DATA -->
                <VBox spacing="12"
                      styleClass="info-panel">

                    <Label text="TODAY'S DATA"
                           styleClass="data-heading"/>

                    <Label text="Latest saved records — not live measurements"
                           wrapText="true"
                           style="-fx-text-fill: #c7a96b;"/>

                    <Separator/>

                    <GridPane hgap="12" vgap="16">

                        <Label text="Soil Moisture"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="sidebarMoistureLabel"
                               text="—"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                        <Label text="Crop Health"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="sidebarHealthLabel"
                               text="—"
                               wrapText="true"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                        <Label text="Total Drones"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="sidebarDronesLabel"
                               text="—"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                        <Label text="Ready to Harvest"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="0"/>

                        <Label fx:id="sidebarHarvestLabel"
                               text="—"
                               wrapText="true"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>
                    </GridPane>

                    <Label fx:id="sidebarReadingLabel"
                           text="No reading loaded"
                           wrapText="true"
                           style="-fx-text-fill: #aab8c5;"/>

                    <Separator/>

                    <GridPane hgap="12" vgap="16">

                        <Label text="Temperature"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                        <Label text="No data"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                        <Label text="Humidity"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                        <Label text="No data"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </right>

    <!-- STATUS FOOTER -->
    <bottom>
        <VBox spacing="3"
              style="-fx-background-color: #17232e;">

            <padding>
                <Insets top="8" right="14" bottom="8" left="14"/>
            </padding>

            <Label fx:id="statusLabel"
                   text="Starting..."
                   wrapText="true"
                   style="-fx-text-fill: #d8e4ed;"/>

            <Label fx:id="dataPathLabel"
                   wrapText="true"
                   style="-fx-font-size: 10px; -fx-text-fill: #96a8b8;"/>
        </VBox>
    </bottom>

</BorderPane>